-- SAFE COREGUI ACCESS (Critical for mobile/executor compatibility)
-- ═══════════════════════════════════════════════════════════
local function getSafeGuiParent()
    -- Try CoreGui first (works on most executors)
    local success, coreGui = pcall(function()
        return game:GetService("CoreGui")
    end)
    
    if success and coreGui then
        return coreGui
    end
    
    -- Fallback to PlayerGui (works on Delta mobile, Xeno web, etc.)
    return player:WaitForChild("PlayerGui", 10)
end

