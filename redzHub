-- ═══════════════════════════════════════════════════════════
-- UNIVERSAL CLIPBOARD FUNCTION (Max Executor Compatibility)
-- ═══════════════════════════════════════════════════════════
local function copyToClipboard(text)
    -- Method 1: Standard setclipboard (Xeno, Solara, Codex, most modern executors)
    if setclipboard then
        local success = pcall(function()
            setclipboard(text)
        end)
        if success then return true end
    end
    
    -- Method 2: toclipboard (some executors)
    if toclipboard then
        local success = pcall(function()
            toclipboard(text)
        end)
        if success then return true end
    end
    
    -- Method 3: clipboard library (older executors)
    if clipboard and clipboard.set then
        local success = pcall(function()
            clipboard.set(text)
        end)
        if success then return true end
    end
    
    -- Method 4: syn.write_clipboard (Synapse X legacy)
    if syn and syn.write_clipboard then
        local success = pcall(function()
            syn.write_clipboard(text)
        end)
        if success then return true end
    end
    
    -- Method 5: Delta mobile clipboard (if available)
    if Delta and Delta.Clipboard and Delta.Clipboard.Set then
        local success = pcall(function()
            Delta.Clipboard.Set(text)
        end)
        if success then return true end
    end
    
    -- Method 6: Xeno custom clipboard (if available)
    if Xeno and Xeno.Clipboard and Xeno.Clipboard.Set then
        local success = pcall(function()
            Xeno.Clipboard.Set(text)
        end)
        if success then return true end
    end
    
    -- Method 7: Solara clipboard (if available)
    if Solara and Solara.setclipboard then
        local success = pcall(function()
            Solara.setclipboard(text)
        end)
        if success then return true end
    end
    
    return false
end

